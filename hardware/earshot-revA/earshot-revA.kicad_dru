(version 1)
# HRO TYPE-C-31-M-12 footprint (from LCSC/JLCPCB): VBUS and GND pins sit 0.8 mm apart by design.
# JLCPCB's 4-layer minimum spacing is 0.09 mm, so allow 0.1 mm between pads inside J1 only.
(rule "USB-C internal pad spacing"
  (constraint clearance (min 0.1mm))
  (condition "A.Parent == 'J1' && B.Parent == 'J1'"))
